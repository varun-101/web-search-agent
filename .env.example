# Any OpenAI-compatible Chat Completions endpoint. Leave OPENAI_BASE_URL empty for OpenAI itself.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MAIN_MODEL=gpt-5            # the reasoning loop; edit to your provider's model id
NOTE_MODEL=gpt-5-mini       # writes the memory note after each reply
JUDGE_MODEL=                # optional, eval grader; defaults to MAIN_MODEL
REASONING_EFFORT=           # optional: minimal | low | medium | high (only sent when set)

EXA_API_KEY=
TAVILY_API_KEY=             # optional, used only as a fallback
SEARCH_MODE=live            # live | record | replay
NOW=                        # optional, e.g. 2026-11-11T10:14:00+00:00
PORT=3000
